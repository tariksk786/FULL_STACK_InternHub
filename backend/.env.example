# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Defaults to internhub.sqlite in workspace root; can be set to absolute or custom path
DB_PATH=internhub.sqlite

# Security & CORS
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
# Max submission attempts per window (default: 5 requests per 15 minutes)
APPLICATION_RATE_LIMIT=5
